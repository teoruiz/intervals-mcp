# Copy to .env and fill in. Never commit .env.
#
# This file has two jobs:
#
#   1. Local config for the Go MCP server and the `intervals` CLI, which read
#      the INTERVALS_ICU_* values from it.
#   2. The production Worker secret bundle. Upload all of it in one request:
#
#        wrangler secret bulk .env
#
# `secret bulk` uploads EVERY uncommented key in this file as a Worker secret,
# so local-only settings stay commented out below. The GitHub values here are
# the PRODUCTION OAuth App. Local Worker development uses .dev.vars with a
# separate local OAuth App; see .dev.vars.example.

# Intervals.icu credentials. The Worker passes these into the container.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# Production GitHub OAuth App, plus the comma-separated access allowlist.
# The allowlist fails closed when empty.
# Generate the cookie key with: openssl rand -hex 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_ENCRYPTION_KEY=
ALLOWED_GITHUB_USERS=

# Optional, local only. Uncomment to override a default when running the Go
# server or CLI on your machine. Leave them commented for deploys: the
# container sets its own MCP_ADDR and always uses the default Intervals.icu
# base URL.
# INTERVALS_ICU_BASE_URL=https://intervals.icu
# MCP_ADDR=127.0.0.1:8080
# REQUEST_TIMEOUT=15s
# SHUTDOWN_TIMEOUT=10s
