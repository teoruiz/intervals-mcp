# Required for every mode (server, CLI, and `intervals-mcp --local`).
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_BASE_URL=https://intervals.icu

# Everything below is only used by the authenticated server.
# `intervals-mcp --local` ignores the Supabase/OIDC and MCP_PUBLIC_URL values.
MCP_ADDR=:8080
MCP_PUBLIC_URL=https://your-domain.example
MCP_REQUIRED_SCOPE=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY= # accepted as an alias for SUPABASE_ANON_KEY
# Optional comma-separated social-login providers, for example github,google.
SUPABASE_OAUTH_PROVIDERS=

OIDC_ISSUER_URL=https://your-project-ref.supabase.co/auth/v1
# OIDC_JWKS_URL defaults to $OIDC_ISSUER_URL/.well-known/jwks.json
OIDC_AUDIENCE=authenticated
OIDC_ALLOWED_EMAIL=you@example.com
# OIDC_ALLOWED_SUBJECT=
