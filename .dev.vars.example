# Copy to .dev.vars for local Worker development (`npm run dev`).
# These are the LOCAL GitHub OAuth App, whose callback is
# http://localhost:8787/callback. Production values live in .env and are
# uploaded with `wrangler secret bulk .env`. Never commit .dev.vars.
GITHUB_CLIENT_ID="replace-with-local-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-local-github-oauth-client-secret"
COOKIE_ENCRYPTION_KEY="replace-with-output-of-openssl-rand-hex-32"
ALLOWED_GITHUB_USERS="your-github-login"
INTERVALS_ICU_API_KEY="replace-with-intervals-icu-api-key"
INTERVALS_ICU_ATHLETE_ID="replace-with-intervals-icu-athlete-id"
